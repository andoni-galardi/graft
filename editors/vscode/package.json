{
  "name": "graft-vscode",
  "displayName": "Graft",
  "description": "Apply .graft change files to your project",
  "version": "0.7.0",



  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/andoni-galardi/graft.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/andoni-galardi/graft#readme",
  "contributes": {
    "commands": [
      {
        "command": "graft.focus",
        "title": "Focus panel",
        "category": "Graft"
      },
      {
        "command": "graft.new",
        "title": "New changes file",
        "category": "Graft"
      },
      {
        "command": "graft.pick",
        "title": "Pick changes file",
        "category": "Graft"
      },
      {
        "command": "graft.open",
        "title": "Open changes file in editor",
        "category": "Graft"
      },
      {
        "command": "graft.validate",
        "title": "Validate changes file",
        "category": "Graft"
      },
      {
        "command": "graft.apply",
        "title": "Apply changes file",
        "category": "Graft"
      },
      {
        "command": "graft.paste",
        "title": "Paste from clipboard",
        "category": "Graft"
      },
      {
        "command": "graft.applyClipboard",
        "title": "Apply Clipboard",
        "category": "Graft"
      }

    ],
        "menus": {
          "view/title": [
            {
              "command": "graft.new",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "1_file@1"
            },
            {
              "command": "graft.pick",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "1_file@2"
            },
            {
              "command": "graft.open",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "1_file@3"
            },
            {
              "command": "graft.paste",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "2_clipboard@1"
            },
            {
              "command": "graft.applyClipboard",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "2_clipboard@2"
            },
            {
              "command": "graft.validate",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "3_actions@1"
            },
            {
              "command": "graft.apply",
              "when": "view == graft.panel || view == graft.explorer",
              "group": "3_actions@2"
            }
          ]
        },

    "viewsContainers": {

      "activitybar": [
        {
          "id": "graft",
          "title": "Graft",
          "icon": "media/graft.svg"
        }
      ]
    },
    "views": {
      "graft": [
        {
          "id": "graft.panel",
          "name": "Changes",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "graft.explorer",
          "name": "Graft changes",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Graft",
      "properties": {
        "graft.paste.confirmOnReplace": {
          "type": "boolean",
          "default": true,
          "description": "Ask before replacing a non-empty changes file when using Paste."
        },
        "graft.apply.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview confirmation dialog before applying changes."
        },
        "graft.applyClipboard.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview confirmation dialog before applying changes from the clipboard."
        },

        "graft.ui.colors.patch": {
          "type": "string",
          "default": "",
          "description": "Custom color for 'patch' operations (e.g. #00AAFF or var(--vscode-charts-blue))"
        },
        "graft.ui.colors.write": {
          "type": "string",
          "default": "",
          "description": "Custom color for 'write' operations (e.g. #FFA500)"
        },
        "graft.ui.colors.delete": {
          "type": "string",
          "default": "",
          "description": "Custom color for 'delete' operations (e.g. #FF0000)"
        },
        "graft.ui.colors.mkdir": {
          "type": "string",
          "default": "",
          "description": "Custom color for 'mkdir' operations (e.g. #00FF00)"
        },
        "graft.ui.colors.rename": {
          "type": "string",
          "default": "",
          "description": "Custom color for 'rename' operations (e.g. #AA00FF)"
        }


      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run clean && npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@andoni.galardi/graft": "file:../..",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.4"
  }
}
