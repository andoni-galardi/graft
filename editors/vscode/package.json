{
  "name": "graft-vscode",
  "displayName": "Graft",
  "description": "Apply .graft change files to your project",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/andoni-galardi/graft.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "commands": [
      {
        "command": "graft.focus",
        "title": "Focus panel",
        "category": "Graft"
      },
      {
        "command": "graft.new",
        "title": "New changes file",
        "category": "Graft"
      },
      {
        "command": "graft.pick",
        "title": "Pick changes file",
        "category": "Graft"
      },
      {
        "command": "graft.open",
        "title": "Open changes file in editor",
        "category": "Graft"
      },
      {
        "command": "graft.validate",
        "title": "Validate changes file",
        "category": "Graft"
      },
      {
        "command": "graft.apply",
        "title": "Apply changes file",
        "category": "Graft"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graft",
          "title": "Graft",
          "icon": "media/graft.svg"
        }
      ]
    },
    "views": {
      "graft": [
        {
          "id": "graft.panel",
          "name": "Changes",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "graft.explorer",
          "name": "Graft changes",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Graft",
      "properties": {
        "graft.paste.confirmOnReplace": {
          "type": "boolean",
          "default": true,
          "description": "Ask before replacing a non-empty changes file when using Paste."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run clean && npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@andoni.galardi/graft": "file:../..",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.4"
  }
}
